[Unit]
Description=VPS Monitor Panel
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/traffic-panel
ExecStart=/root/traffic-panel/.venv/bin/python main.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
User=trafficpanel
Group=trafficpanel

[Install]
WantedBy=multi-user.target
